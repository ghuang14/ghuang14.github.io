{
  "name": "edge-services",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Workers + D1 services for this site.",
  "scripts": {
    "test": "node test/worker.test.mjs && node test/beacon.test.mjs",
    "dev": "wrangler dev",
